# Loaded instead of .env whenever APP_ENV=testing (phpunit.xml forces that, and
# `--env=testing` selects it for artisan). Committed on purpose: nothing here is
# secret — the DB credentials are the docker-compose dev ones, and the APP_KEY is
# a throwaway used only to make encrypted cookies/sessions work under test.
# Tests are additionally guarded in tests/TestCase.php, which aborts unless the
# resolved database name ends in "_testing".
APP_ENV=testing
APP_KEY=base64:3sCktyOiJwgz92olu+03jCFE6gqSuvxG6F3WLXDM8/M=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stampy_testing
DB_USERNAME=attendance
DB_PASSWORD=secret
